      "id": "556c8fd0-f47a-452b-97eb-bf8665cde16a",
      "name": "Final Response"
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prepare').first().json;\nlet docs = [];\nif (prep.hasNotes) {\n  const allowed = new Set(prep.note_ids);\n  docs = $input.all()\n    .map(i => i.json.document || i.json)\n    .filter(d => d && d.pageContent && d.metadata\n      && d.metadata.user_id === prep.user_id\n      && allowed.has(d.metadata.note_id))\n    .slice(0, prep.top_k);\n}\nconst context = docs.map((d, i) => `[${i + 1}] ${d.pageContent}`).join('\\n\\n');\nconst sources = [...new Set(docs.map(d => d.metadata.note_id))];\nreturn [{ json: { ...prep, context, sources } }];"
      },
