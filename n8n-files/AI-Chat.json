      "parameters": {
        "jsCode": "const prep = $('Build Context').first().json;\nconst answer = ($input.first().json.text ?? $input.first().json.output ?? '').trim();\nreturn [{ json: { job_id: prep.job_id, answer, model: 'gemma3:4b', sources: prep.sources } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
