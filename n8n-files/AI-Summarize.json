      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst raw = $input.first().json.text ?? $input.first().json.output ?? '';\nconst maxCards = Number(body.max_cards) || 10;\nconst cards = raw\n  .split('\\n')\n  .map(s => s.replace(/^[\\s\\-\\*\\d\\.\\)]+/, '').trim())\n  .filter(s => s.length > 0 && s.length <= 1000)\n  .slice(0, maxCards);\nreturn [{ json: { job_id: body.job_id, cards, model: 'gemma3:4b' } }];"
      },
