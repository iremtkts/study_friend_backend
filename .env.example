# Local PostgreSQL values; replace placeholders before starting Compose.
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql+psycopg://<user>:<password>@db:5432/<database>

# Required application signing key; use a random value of at least 32 characters.
JWT_SECRET_KEY=replace_with_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth credentials and callback URL.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# SMTP settings for verification and password-reset email.
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM=replace_with_sender_email

# Frontend URL and account security settings.
FRONTEND_URL=http://127.0.0.1:3000
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
COOKIE_SECURE=false

# File storage: local or cloudinary.
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Quiz, summary and AI request limits.
SUMMARY_MAX_CHARS=1000
QUIZ_QUESTION_TEXT_MAX_CHARS=1000
QUIZ_OPTIONS_MIN_COUNT=2
QUIZ_OPTIONS_MAX_COUNT=6
QUIZ_OPTION_MAX_CHARS=300
QUIZ_EXPLANATION_MAX_CHARS=1500
QUIZ_QUESTIONS_MIN_COUNT=1
QUIZ_QUESTIONS_MAX_COUNT=30
N8N_BASE_URL=https://replace_with_n8n_host
N8N_WEBHOOK_SECRET=replace_with_n8n_webhook_secret
N8N_TIMEOUT_SECONDS=90
AI_MAX_INPUT_CHARS=30000
AI_DAILY_LIMIT_FREE=3
AI_DAILY_LIMIT_PLUS=30
AI_CHAT_DAILY_LIMIT_FREE=50
AI_CHAT_DAILY_LIMIT_PLUS=500
CHAT_HISTORY_LIMIT=10
CHAT_TOP_K=4
CHAT_MAX_NOTE_IDS=200
AI_SUMMARY_MAX_CARDS=15
AI_CARD_TARGET_CHARS=400
AI_OUTPUT_LANGUAGE=tr
INDEX_MAX_INPUT_CHARS=20000
